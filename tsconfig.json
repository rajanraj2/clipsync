{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@clipsync/shared-types": ["packages/shared-types/src/index.ts"],
      "@clipsync/protocol-schema": ["packages/protocol-schema/src/index.ts"],
      "@clipsync/storage": ["packages/storage/src/index.ts"],
      "@clipsync/api-client": ["packages/api-client/src/index.ts"],
      "@clipsync/api": ["services/api/src/index.ts"],
      "@clipsync/relay": ["services/relay/src/index.ts"]
    }
  }
}
