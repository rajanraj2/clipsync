{
  "name": "@clipsync/cli",
  "version": "0.1.2",
  "description": "Cross-platform command line interface for ClipSync clipboard synchronization",
  "bin": {
    "clipsync": "./bin/clipsync.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clipsync/api-client": "workspace:*",
    "@clipsync/protocol-schema": "workspace:*",
    "@clipsync/shared-types": "workspace:*",
    "@clipsync/storage": "workspace:*",
    "@clipsync/sync-engine": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
